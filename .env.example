# Copy this file to .env and fill in your values:
#   cp .env.example .env

# --- Database ---
DATABASE_URL=sqlite:///./agent_platform.db

# --- Execution settings ---
# Hard cap on tool-execution steps per agent run.
MAX_EXECUTION_STEPS=5

# --- Tenant API keys ---
# Each key maps to one tenant. Generate real random strings:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY_TENANT_A=your-api-key-here
API_KEY_TENANT_B=your-api-key-here
API_KEY_TENANT_C=your-api-key-here

# --- LLM provider ---
# Get a key at https://console.groq.com
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# --- RAG ---
# Downloaded from HuggingFace on first use and cached locally.
EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CHROMA_PATH=./chroma_db
