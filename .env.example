# Copy this file to .env and fill in your values:
#   cp .env.example .env

# --- Database ---
DATABASE_URL=sqlite:///./agent_platform.db

# --- Execution settings ---
# Hard cap on tool-execution steps per agent run.
MAX_EXECUTION_STEPS=5
# Hard cap on model turns per agent run (at least 1). Catches tools that
# record no step, such as `think`.
MAX_MODEL_CALLS=5

# --- Tenant API keys ---
# Each key maps to one tenant. Generate real random strings:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY_TENANT_A=your-api-key-here
API_KEY_TENANT_B=your-api-key-here
API_KEY_TENANT_C=your-api-key-here

# --- LLM provider ---
# Get a key at https://console.groq.com
GROQ_API_KEY=your-groq-api-key-here

# Default model, used when the platform calls an LLM on its own behalf
# (query expansion, RAG answer generation). Leave unset to use the
# application default.
#
# Groq retires models, so a name that worked last month may 404 today. To
# list what your own account serves:
#   python -c "from app.core.llm import _groq_client; \
#       print(sorted(m.id for m in _groq_client().models.list().data))"
# GROQ_MODEL=openai/gpt-oss-120b

# Comma-separated list of models callers may request via the API's `model`
# field. Defaults to GROQ_MODEL alone. Every name here must be one your
# account can actually serve, or runs against it return 502.
# GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b

# --- Cost accounting ---
# Per-model prices in USD per million tokens. No price table is bundled:
# provider prices change, and a stale table would bill tenants wrongly. A
# model with no entry here reports cost as null rather than zero.
# MODEL_PRICING={"openai/gpt-oss-120b":{"input":0.15,"output":0.60}}

# --- RAG pipeline stages ---
# Expansion costs an LLM call per search; reranking runs a cross-encoder
# over every candidate. Whether either earns its latency depends on your
# corpus — measure first:
#   docker compose exec api python -m evals.retrieval_eval
# RAG_USE_EXPANSION=true
# RAG_USE_RERANK=true
# RAG_CANDIDATE_POOL=10
# RAG_TOP_K=3

# --- RAG ---
# Downloaded from HuggingFace on first use and cached locally.
EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CHROMA_PATH=./chroma_db
